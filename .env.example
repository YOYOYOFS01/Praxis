# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Security ─────────────────────────────────────────────────────────────────
# API key required for all write endpoints (POST /api/purchase, POST approve)
# Leave empty to disable auth (local dev only — NEVER leave empty in production)
API_SECRET_KEY=

# ─── Mode flags — change these to upgrade integrations ────────────────────────
# mock | hybrid | x402
PAYMENT_MODE=mock
# mock | local | base-sepolia
CHAIN_MODE=mock
# true = skip LLM agents entirely (full end-to-end demo without OpenAI key)
MOCK_AGENTS=true
# 0 = auto-approve all; set > 0 to trigger HITL above this USD threshold
HITL_THRESHOLD_USDC=0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Policy limits ────────────────────────────────────────────────────────────
AGENT_MAX_PAYMENT_USDC=1000
TENANT_DAILY_BUDGET_USD=100000

# ─── x402 (required for PAYMENT_MODE=x402) ────────────────────────────────────
FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
VENDOR_RECEIVER_ADDRESS=0x...
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Blockchain (required for CHAIN_MODE=base-sepolia) ────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
AGENT_PRIVATE_KEY=0x...
PRAXIS_REGISTRY_ADDRESS=0x...

# ─── Coinbase CDP (optional — only for x402 + CDP wallet) ─────────────────────
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ─── x402 Gateway (required when PAYMENT_MODE=x402) ──────────────────────────
# 32-byte hex secret for HMAC between withX402 middleware and Facilitator
GATEWAY_INTERNAL_SECRET=

# Server wallet private key for facilitator settlement mode (0x prefixed)
GATEWAY_PRIVATE_KEY=

# Settlement mode: pre-signed (default) or facilitator
SETTLEMENT_MODE=pre-signed

# Timeout in ms to wait for transaction receipt (default 30000)
GATEWAY_SETTLEMENT_TIMEOUT_MS=30000

# Chain to use by default (84532 = Base Sepolia, 8453 = Base Mainnet)
DEFAULT_CHAIN_ID=84532

# RPC endpoint for Base Mainnet (required if DEFAULT_CHAIN_ID=8453)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Secret for internal cron routes (X-Cron-Secret header)
CRON_SECRET=

# Set to true to bypass crypto verification in local dev (NEVER use in production)
GATEWAY_MOCK_VERIFY=false

# Receiver address for x402 gateway payments (used by withX402 if config.payTo is omitted)
GATEWAY_PAY_TO=0x...
