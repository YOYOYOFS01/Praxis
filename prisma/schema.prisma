generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT — top-level org unit. Each tenant has its own budget, policies,
//          vendor allowlist, and API keys.
// ─────────────────────────────────────────────────────────────────────────────
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique   // e.g. "acme-corp" — used in API key prefix
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKeys       ApiKey[]
  runs          Run[]
  users         User[]
  policyConfig  PolicyConfig?
  vendorAllowlist VendorAllowlist[]
  auditLogs     AuditLog[]
}

// ─────────────────────────────────────────────────────────────────────────────
// API KEY — hashed bearer token. One tenant can have multiple keys
//           (rotation, per-service scoping).
//
// Never store raw keys. Store only the SHA-256 hash.
// The raw key is shown once at creation time and never again.
// ─────────────────────────────────────────────────────────────────────────────
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String                      // human label e.g. "CI pipeline", "dashboard"
  keyHash     String    @unique           // SHA-256 of raw key (hex, no prefix)
  keyPrefix   String                      // first 8 chars of raw key for display e.g. "prx_live"
  scopes      String    @default("run:create,run:read,run:approve")  // comma-separated
  isActive    Boolean   @default(true)
  expiresAt   DateTime?                   // null = never expires
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([keyHash])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// POLICY CONFIG — per-tenant payment limits and guard settings.
//                Overrides the global env-var defaults.
// ─────────────────────────────────────────────────────────────────────────────
model PolicyConfig {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  maxSinglePaymentUsdc  Float    @default(50000)
  dailyBudgetUsd        Float    @default(500000)
  hitlThresholdUsdc     Float    @default(0)       // 0 = always auto-approve
  requireProofForAll    Boolean  @default(true)
  allowMockPayments     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // x402 gateway flags
  allowX402Gateway      Boolean  @default(true)
  x402SettlementMode    String   @default("pre-signed")  // "pre-signed" | "facilitator"
  x402MaxAmountUsdc     String   @default("100.00")      // String — never Float

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDOR ALLOWLIST — per-tenant list of approved vendors.
//                    Replaces the hardcoded array in policy-guard.ts.
// ─────────────────────────────────────────────────────────────────────────────
model VendorAllowlist {
  id             String   @id @default(cuid())
  tenantId       String
  vendorName     String                            // stored lowercase for comparison
  paymentAddress String?                           // optional EVM address lock
  maxOrderUsdc   Float?                            // optional per-vendor cap
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, vendorName])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// RUN — one procurement workflow execution.
//       Now tenant-scoped. All JSON stored as String (SQLite limitation).
// ─────────────────────────────────────────────────────────────────────────────
model Run {
  id              String    @id @default(cuid())
  tenantId        String?                          // null = legacy / demo run
  userId          String?
  apiKeyId        String?                          // which key triggered this run
  status          String    @default("running")
  prompt          String
  intentJson      String?
  quoteJson       String?
  budgetJson      String?
  policyJson      String?
  proofJson       String?
  proofHash       String?
  paymentJson     String?
  receiptJson     String?
  protectedJson   String?
  chainAnchorJson String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  events  RunEvent[]
  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([proofHash])
}

// ─────────────────────────────────────────────────────────────────────────────
// RUN EVENT — timeline entry for a single workflow step.
// ─────────────────────────────────────────────────────────────────────────────
model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  type      String   // workflow | guard | proof | payment | chain | hitl
  label     String
  status    String   // pending | success | failed | rejected
  payload   String?  // JSON string
  createdAt DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG — immutable record of every security-relevant action.
//             Never deleted. Append-only by design.
// ─────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  apiKeyId  String?
  action    String   // e.g. "run.create", "run.approve", "key.create", "key.revoke"
  actorType String   // "api_key" | "system" | "human"
  resourceId String? // runId, apiKeyId, etc.
  metadata  String?  // JSON string — sanitised (no secrets)
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  apiKey ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER — end user of the platform.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String                        // bcrypt, cost factor 12
  name         String?
  avatarUrl    String?
  role         String    @default("user")    // "user" | "admin"
  tenantId     String?                       // optional org linkage
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  walletPin       String?                       // bcrypt hash of 6-digit PIN
  walletPinSetAt  DateTime?
  totpSecret      String?                       // encrypted TOTP secret
  totpEnabled     Boolean   @default(false)
  backupCodes     String?                       // JSON array of hashed backup codes

  tenant  Tenant?   @relation(fields: [tenantId], references: [id])
  runs    Run[]                              // runs initiated by this user
  sessions Session[]
  wallets   Wallet[]
  spending  SpendingLimit?
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION — user sessions.
// ─────────────────────────────────────────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique               // SHA-256 of raw session token
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([token])
  @@index([userId])
}

// Tracks failed auth attempts per IP + per email for rate limiting
model AuthRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique             // "login:<ip>" | "login_user:<emailHash>"
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
  lockedUntil DateTime?
  @@index([key])
}

model SpendingLimit {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  dailyLimitUsdc           Float    @default(10000)
  perTxLimitUsdc           Float    @default(5000)
  requireApprovalAboveUsdc Float    @default(1000)
  updatedAt                DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id         String   @id @default(cuid())
  userId     String
  address    String                        // checksummed EVM address
  chainId    Int
  label      String?                       // user nickname e.g. "My MetaMask"
  walletType String   @default("injected") // injected | walletconnect | coinbase | ledger
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, address, chainId])
}

// ─────────────────────────────────────────────────────────────────────────────
// x402 PAYMENT GATEWAY MODELS
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// NONCE RECORD — Replay protection registry.
//                Tracks nonces issued in 402 responses. Each nonce is consumable
//                exactly once, with a TTL hard-capped at 300 seconds.
// ─────────────────────────────────────────────────────────────────────────────
model NonceRecord {
  id          String    @id @default(cuid())
  nonce       String    @unique              // crypto.randomUUID() — never reused
  resource    String                         // URL of the protected endpoint
  amountUsdc  String                         // expected payment amount (String, never Float)
  payTo       String                         // expected receiver address (checksummed)
  network     String                         // CAIP-2 e.g. "eip155:84532"
  status      String    @default("pending")  // "pending" | "used" | "expired"
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime                       // issuedAt + nonceTtlSeconds (capped at 300s)
  usedAt      DateTime?                      // set when status → "used"
  usedByTx    String?                        // txHash of the payment that consumed this nonce
  ipAddress   String?                        // IP that triggered the 402

  @@index([nonce])
  @@index([status])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT RECORD — Verified payment ledger.
//                  Immutable record of every successful x402 payment.
// ─────────────────────────────────────────────────────────────────────────────
model PaymentRecord {
  id                String   @id @default(cuid())
  nonce             String   @unique
  paymentIntentId   String   @unique          // FK to PaymentIntent
  resource          String
  payerAddress      String                    // recovered from EIP-712 signature
  payTo             String
  amountUsdc        String                    // human-readable string e.g. "1.00" — never Float
  amountAtomicUnits String                    // e.g. "1000000" — for BigInt on-chain comparison
  asset             String                    // USDC contract address
  network           String                    // CAIP-2
  chainId           Int                       // numeric chain ID from ChainConfig
  signature         String
  txHash            String?
  settlementMode    String                    // "pre-signed" | "facilitator"
  verifiedAt        DateTime @default(now())
  tenantId          String?
  runId             String?

  @@index([resource])
  @@index([payerAddress])
  @@index([verifiedAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT INTENT — Lifecycle tracker for payment attempts.
//                  Only created when X-Payment header is present (not on raw 402).
//                  Prevents DB bloat from abandoned 402s (bots, crawlers).
// ─────────────────────────────────────────────────────────────────────────────
model PaymentIntent {
  id              String    @id @default(cuid())
  nonce           String    @unique
  correlationId   String?                     // from X-Request-Id header — for log tracing
  idempotencyKey  String?   @unique           // from Idempotency-Key header — dedup retries
  resource        String
  amountUsdc      String                      // string — never Float
  payTo           String
  payerAddress    String?                     // set when CREATED (recovered from sig)
  chainId         Int
  status          String    @default("CREATED")  // "CREATED" | "VERIFYING" | "SETTLED" | "FAILED"
  failureReason   String?
  paymentRecordId String?                     // set when SETTLED
  createdAt       DateTime  @default(now())   // when X-Payment header first received
  verifyingAt     DateTime?
  settledAt       DateTime?
  failedAt        DateTime?
  expiresAt       DateTime                    // matches NonceRecord.expiresAt

  @@index([nonce])
  @@index([status])
  @@index([resource])
  @@index([createdAt])
  @@index([correlationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENDPOINT CONFIG — Gateway-protected route registry.
//                   Defines payment parameters for each x402-protected endpoint.
// ─────────────────────────────────────────────────────────────────────────────
model EndpointConfig {
  id              String   @id @default(cuid())
  resource        String   @unique
  amountUsdc      String                      // string — never Float
  description     String
  payTo           String
  asset           String                      // from ChainConfig — not hardcoded
  network         String                      // CAIP-2 from ChainConfig
  chainId         Int                         // numeric chain ID
  nonceTtlSeconds Int      @default(300)
  isActive        Boolean  @default(true)
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([resource])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WEBHOOK ENDPOINT — Tenant-configured webhook URLs for x402 events.
// ─────────────────────────────────────────────────────────────────────────────
model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String?
  url       String
  secret    String                            // for HMAC-SHA256 signature
  events    String                            // JSON array stored as string
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// WEBHOOK DELIVERY — Async webhook delivery queue.
//                    Worker processes queued rows with retry backoff.
// ─────────────────────────────────────────────────────────────────────────────
model WebhookDelivery {
  id             String    @id @default(cuid())
  endpointId     String
  event          String
  payload        String                        // JSON stored as string
  correlationId  String?
  responseStatus Int?
  attemptCount   Int       @default(0)
  nextRetryAt    DateTime?
  status         String    @default("queued")  // "queued" | "delivered" | "dead"
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
}
